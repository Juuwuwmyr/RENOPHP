# Horizon PHP Framework - .gitignore

# === COMPOSER ===
/vendor/
composer.phar
composer.lock
auth.json

# === PHP ===
*.log
*.tmp
*.temp
.DS_Store
Thumbs.db

# === Environment & Configuration ===
.env
.env.local
.env.production
.env.testing
.env.*.local

# === Cache & Storage ===
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*
/bootstrap/cache/*
*.cache

# === Testing ===
.phpunit.result.cache
/coverage/
/tests/coverage/
phpunit.xml
.phpunit.cache/
/build/

# === IDE & Editors ===
.vscode/
.idea/
*.swp
*.swo
*~
.project
.buildpath
.settings/
nbproject/

# === Node.js & NPM (for frontend assets) ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# === Operating System ===
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon

# Linux
*~
.directory

# === Development Tools ===
.phpstorm.meta.php
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php

# === Backup files ===
*.bak
*.backup
*.old
*.orig

# === Temporary files ===
/tmp/
/temp/
*.tmp
*.temp

# === Documentation build files ===
/docs/_build/
/docs/build/

# === Package files ===
*.tar.gz
*.zip
*.rar
*.7z

# === Framework specific ===
/framework/storage/logs/*
/framework/storage/framework/cache/*
/framework/storage/framework/sessions/*
/framework/storage/framework/testing/*
/framework/storage/framework/views/*
/framework/bootstrap/cache/*

# Keep important empty directories
!storage/app/.gitkeep
!storage/framework/.gitkeep
!storage/framework/cache/.gitkeep
!storage/framework/sessions/.gitkeep  
!storage/framework/testing/.gitkeep
!storage/framework/views/.gitkeep
!storage/logs/.gitkeep
!bootstrap/cache/.gitkeep

# === Ignore but keep structure ===
*
!.gitignore
!*.md
!*.php
!*.json
!*.xml
!*.yml
!*.yaml
!**/
!LICENSE
!.gitkeep
!.htaccess